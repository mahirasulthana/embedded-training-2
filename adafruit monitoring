#include <Arduino.h>
#include <DHT.h>
#include "AdafruitIO_WiFi.h"

// Adafruit IO credentials
#define IO_USERNAME  "Mahi2004"
#define IO_KEY       "aio_ttTi11O9kzjAKbzuu9UBqPrE4gc3"
// Wi-Fi credentials
#define WIFI_SSID "Mamatha's moto g45"
#define WIFI_PASS "Amuthamani@07"

// Sensor and buzzer
#define DHT_PIN 4
#define BUZZER_PIN 25
#define DHT_TYPE DHT11

const float ON_TEMP = 30.0;
const float OFF_TEMP = 29.0;

struct SensorData {
  float temp;
  float humidity;
};

DHT dht(DHT_PIN, DHT_TYPE);

AdafruitIO_WiFi io(
  IO_USERNAME, IO_KEY, WIFI_SSID, WIFI_PASS
);

// Adafruit IO feeds
AdafruitIO_Feed *tempFeed = io.feed("temperature");
AdafruitIO_Feed *humFeed = io.feed("humidity");
AdafruitIO_Feed *buzzerFeed = io.feed("buzzer");

// Shared states
volatile bool manualBuzzerOn = false;
volatile bool temperatureAlarm = false;

QueueHandle_t displayQueue;
QueueHandle_t alertQueue;

// Update buzzer from either control source
void updateBuzzer() {
  bool buzzerOn = manualBuzzerOn || temperatureAlarm;

  digitalWrite(BUZZER_PIN, buzzerOn ? HIGH : LOW);
}

// Called when the dashboard buzzer feed changes
void handleBuzzer(AdafruitIO_Data *data) {
  int value = data->toInt();

  manualBuzzerOn = (value == 1);

  Serial.print("Dashboard buzzer: ");
  Serial.println(manualBuzzerOn ? "ON" : "OFF");

  updateBuzzer();
}

// Read DHT11 and upload readings
void sensorTask(void *p) {
  SensorData d;
  unsigned long lastUpload = 0;

  while (true) {
    d.temp = dht.readTemperature();
    d.humidity = dht.readHumidity();

    if (!isnan(d.temp) && !isnan(d.humidity)) {
      xQueueOverwrite(displayQueue, &d);
      xQueueOverwrite(alertQueue, &d);

      if (millis() - lastUpload >= 10000) {
        lastUpload = millis();

        if (io.status() == AIO_CONNECTED) {
          tempFeed->save(d.temp);
          humFeed->save(d.humidity);

          Serial.println("Data sent to Adafruit IO");
        } else {
          Serial.println("Adafruit IO disconnected");
        }
      }
    } else {
      Serial.println("DHT11 reading failed");
    }

    vTaskDelay(pdMS_TO_TICKS(2500));
  }
}

// Display temperature and humidity
void displayTask(void *p) {
  SensorData d;

  while (true) {
    if (xQueueReceive(displayQueue, &d,
                      portMAX_DELAY) == pdTRUE) {
      Serial.print("Temp: ");
      Serial.print(d.temp);
      Serial.print(" C | Hum: ");
      Serial.println(d.humidity);
    }
  }
}

// Automatic temperature alarm
void alertTask(void *p) {
  SensorData d;

  while (true) {
    if (xQueueReceive(alertQueue, &d,
                      portMAX_DELAY) == pdTRUE) {

      if (d.temp > ON_TEMP) {
        temperatureAlarm = true;
      } else if (d.temp < OFF_TEMP) {
        temperatureAlarm = false;
      }

      updateBuzzer();

      Serial.print("Temperature alarm: ");
      Serial.println(temperatureAlarm ? "ON" : "OFF");
    }
  }
}

void setup() {
  Serial.begin(115200);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  dht.begin();

  displayQueue = xQueueCreate(1, sizeof(SensorData));
  alertQueue = xQueueCreate(1, sizeof(SensorData));

  if (displayQueue == NULL || alertQueue == NULL) {
    Serial.println("Queue creation failed!");
    while (true) {
      delay(1000);
    }
  }

  // Register dashboard callback BEFORE connecting
  buzzerFeed->onMessage(handleBuzzer);

  Serial.println("Connecting to Adafruit IO...");
  io.connect();

  while (io.status() < AIO_CONNECTED) {
    io.run();
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nAdafruit IO connected!");

  // Read the latest dashboard button value
  buzzerFeed->get();

  xTaskCreate(sensorTask, "Sensor", 4096, NULL, 2, NULL);
  xTaskCreate(displayTask, "Display", 3072, NULL, 1, NULL);
  xTaskCreate(alertTask, "Alert", 3072, NULL, 3, NULL);
}

void loop() {
  // Process Adafruit IO messages and callbacks
  io.run();
  vTaskDelay(pdMS_TO_TICKS(10));
}
